{
  "name": "@my-tdesign-ui/components",
  "version": "0.1.0",
  "description": "基于 tdesign-vue-next 深度定制的 Vue 3 组件库",
  "type": "module",
  "main": "./dist/my-tdesign-ui.umd.cjs",
  "module": "./dist/my-tdesign-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/my-tdesign-ui.js",
      "require": "./dist/my-tdesign-ui.umd.cjs"
    },
    "./style.css": "./dist/style.css",
    "./styles/variables": "./src/styles/variables.scss",
    "./styles/theme": "./src/styles/theme.scss"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "dist",
    "src/styles",
    "docs",
    "ai-manifest.json"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "tdesign-vue-next": "^1.10.0"
  },
  "dependencies": {
    "tdesign-vue-next": "^1.10.0"
  },
  "devDependencies": {
    "vue": "^3.4.0",
    "vite": "^5.4.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "vite-plugin-dts": "^3.9.0",
    "vue-tsc": "^2.0.0",
    "sass": "^1.77.0",
    "@types/node": "^20.14.0"
  }
}
